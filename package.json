{
  "name": "dsh-gigaam-stt",
  "version": "1.0.0",
  "description": "Local Russian speech-to-text for DeepSeek Harness voice input: GigaAM v3 (ONNX int8) on CPU via sherpa-onnx",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "worker.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "scripts/selftest.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "speech-to-text",
    "stt",
    "asr",
    "russian",
    "gigaam",
    "sherpa-onnx",
    "onnx",
    "offline",
    "cpu"
  ],
  "license": "MIT",
  "author": "dsh-gigaam-stt contributors",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OldSchool686/dsh-gigaam-stt.git"
  },
  "homepage": "https://github.com/OldSchool686/dsh-gigaam-stt#readme",
  "bugs": {
    "url": "https://github.com/OldSchool686/dsh-gigaam-stt/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
